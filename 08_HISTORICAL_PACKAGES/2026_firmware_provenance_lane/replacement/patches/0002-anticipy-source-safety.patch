+// SPDX-License-Identifier: MIT
+
+#ifndef ANTICIPY_BATTERY_SMOOTHER_H
+#define ANTICIPY_BATTERY_SMOOTHER_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+struct battery_smoother {
+    uint16_t percentage_q8;
+    bool initialized;
+};
