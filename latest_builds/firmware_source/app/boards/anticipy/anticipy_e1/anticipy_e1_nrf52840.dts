/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/regulator/npm1300.h>
/ {
 model = "Anticipy E1P1 BUCK2-main prototype";
 compatible = "anticipation-labs,anticipy-e1";
 chosen { zephyr,sram = &sram0; zephyr,flash = &flash0; };
 aliases { watchdog0 = &wdt0; };
};
&pinctrl {
 e1_i2c: e1_i2c { group1 { psels = <NRF_PSEL(TWIM_SCL,0,26)>, <NRF_PSEL(TWIM_SDA,0,27)>; }; };
 e1_i2c_sleep: e1_i2c_sleep { group1 { psels = <NRF_PSEL(TWIM_SCL,0,26)>, <NRF_PSEL(TWIM_SDA,0,27)>; low-power-enable; }; };
 e1_spi: e1_spi { group1 { psels = <NRF_PSEL(SPIM_SCK,0,19)>, <NRF_PSEL(SPIM_MOSI,0,21)>, <NRF_PSEL(SPIM_MISO,0,22)>; }; };
 e1_spi_sleep: e1_spi_sleep { group1 { psels = <NRF_PSEL(SPIM_SCK,0,19)>, <NRF_PSEL(SPIM_MOSI,0,21)>, <NRF_PSEL(SPIM_MISO,0,22)>; low-power-enable; }; };
};
&uicr { gpio-as-nreset; };
&gpio0 { status = "okay"; };
&gpio1 { status = "okay"; };
&gpiote { status = "okay"; };
&i2c0 {
 compatible = "nordic,nrf-twim"; status = "okay"; clock-frequency = <I2C_BITRATE_STANDARD>;
 pinctrl-0 = <&e1_i2c>; pinctrl-1 = <&e1_i2c_sleep>; pinctrl-names = "default", "sleep";
 e1_pmic: pmic@6b {
  compatible = "nordic,npm1300"; reg = <0x6b>;
  e1_regulators: regulators {
   compatible = "nordic,npm1300-regulator";
   /* E1P1: BUCK1 is an unloaded 2.5V auxiliary; TP12 goes off after init. */
   e1_buck1: BUCK1 { regulator-min-microvolt = <2500000>; regulator-max-microvolt = <2500000>; regulator-init-microvolt = <2500000>; regulator-boot-off; };
   /* E1P1: BUCK2 supplies the MCU and NAND. Never disable the main rail. */
   e1_buck2: BUCK2 { regulator-min-microvolt = <3000000>; regulator-max-microvolt = <3000000>; regulator-init-microvolt = <3000000>; regulator-always-on; };
  };
  e1_charger: charger {
   compatible = "nordic,npm1300-charger";
   term-microvolt = <4200000>; term-warm-microvolt = <4100000>;
   current-microamp = <40000>; dischg-limit-microamp = <270000>;
   vbus-limit-microamp = <100000>; thermistor-ohms = <10000>;
   /* Required driver property only. e1_board.c uses the TDK 8307 table. */
   thermistor-beta = <4000>;
   /* Charging deliberately disabled in the first bring-up image. */
  };
  e1_leds: leds {
   compatible = "nordic,npm1300-led";
   nordic,led0-mode = "host"; nordic,led1-mode = "host"; nordic,led2-mode = "host";
  };
 };
};
&spi3 {
 compatible = "nordic,nrf-spim"; status = "okay";
 pinctrl-0 = <&e1_spi>; pinctrl-1 = <&e1_spi_sleep>; pinctrl-names = "default", "sleep";
 cs-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;
 nand: nand@0 { compatible = "vnd,spi-device"; reg = <0>; spi-max-frequency = <8000000>; };
};
&flash0 { partitions { compatible = "fixed-partitions"; #address-cells = <1>; #size-cells = <1>;
 code_partition: partition@0 { label = "application"; reg = <0x0 0xfc000>; };
 storage_partition: partition@fc000 { label = "storage"; reg = <0xfc000 0x4000>; };
}; };
